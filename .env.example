# URL base da API do backend (FastAPI)
VITE_API_URL=http://localhost:8000/api/v1

# Padrão: false — o login fala com a API real.
# Ponha "true" para trabalhar na tela sem subir Postgres; o login passa a ser
# validado em memória contra as credenciais do seed (app/db/seed.py).
VITE_USE_MOCK_AUTH=false
